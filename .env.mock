# .env.mock — versioned TEMPLATE. NEVER read by the app.
# Copy it to `.env` (which IS read by the app and is git-ignored) and fill real values.
#   cp .env.mock .env
#
# AIRFLOW_UID = UID the Airflow containers run as (`user: "${AIRFLOW_UID:-50000}:0"`).
# Keep 50000 (the user baked into the official image). Using another UID (e.g. your
# host `id -u`) requires the Airflow entrypoint to run on EVERY service so it can
# create that user in /etc/passwd and set HOME=/home/airflow — otherwise you get
#   ModuleNotFoundError: No module named 'airflow'
AIRFLOW_UID=50000

# Airflow web UI admin account (used by the `airflow-init` service).
# Change it any time with: airflow users reset-password --username admin
AIRFLOW_ADMIN_PASSWORD=change-me-strong-admin-password

# Airflow metadata database (Postgres) password.
# IMPORTANT: this value is only used on the FIRST init of the DB volume. On an
# existing volume, changing it here alone causes:
#   FATAL: password authentication failed for user "airflow"
# Fixes: either ALTER USER inside Postgres (keeps data), or delete the volume (data loss):
#   docker compose exec airflow-postgres psql -U airflow -c "ALTER USER airflow WITH PASSWORD 'NEW'"
#   docker compose down -v   # deletes volumes too
# Use a URL-safe value (letters/digits only): it is injected into
# postgresql+psycopg2://airflow:PASSWORD@airflow-postgres/airflow
POSTGRES_PASSWORD=change-me-strong-postgres-password

# Elasticsearch / Kibana credentials (required by docker-compose.yaml).
ELASTIC_PASSWORD=change-me-elastic
KIBANA_PASSWORD=change-me-kibana

# 32+ char encryption key for Kibana saved objects/security/reporting.
KIBANA_ENCRYPTION_KEY=change-me-at-least-32-characters-long
